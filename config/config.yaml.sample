# CarrotQuant.Data 配置指南
# 配置文件候选加载顺序 (优先级从高到低):
# 1. 环境变量 CQDATA_STORAGE_ROOT="your/path" (最优先)
# 2. 环境变量 CQDATA_CONFIG="/path/to/custom_config.yaml"
# 3. 当前工作目录 ./config/config.yaml 或 ./config.yaml
# 4. 用户主目录 ~/.cqdata/config.yaml
# 5. 源码/默认路径 storage_root

# 存储根目录配置
storage_root: "storage_root"
default_format: "csv"

# 日志配置
logging:
  level: "INFO"
  file: "logs/app.log"
